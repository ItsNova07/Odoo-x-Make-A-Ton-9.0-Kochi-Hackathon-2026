# Copy to .env and replace the placeholder with a long random secret.
MEMBER2_DATABASE_URL=sqlite:///./member2.db
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
JWT_ISSUER=brightloop-sms
ACCESS_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@brightloop.local
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
RATE_LIMIT_ENABLED=true
